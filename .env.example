# ---- Ứng dụng ----
# URL gốc của app (dùng để tạo link file tải lên)
APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=/api

# ---- MySQL (khớp docker-compose.yml) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=workflow_db
# Múi giờ cho NOW() của MySQL (code giả định giờ Việt Nam)
DB_TIMEZONE=+07:00

# ---- Xác thực ----
# Chuỗi bí mật ký JWT - đổi thành chuỗi ngẫu nhiên dài
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30
# Cho phép tự đăng ký tài khoản ở trang /register
ALLOW_REGISTER=true

# Tài khoản quản trị tạo bởi `npm run db:init`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Quản trị viên

# ---- Lưu file ----
STORAGE_DIR=./storage/uploads

# ---- Tuỳ chọn ----
# Bật cron nhắc lịch sử dụng tài nguyên
ENABLE_CRON=true
# Khoá cho API tích hợp bên ngoài (POST /api/fw/create-proposal-reality-by-outside, header x-api-key).
# Để trống = tắt API tích hợp.
FW_INTEGRATION_API_KEY=
# Chrome/Chromium cho chức năng xuất PDF (puppeteer). Để trống: tự tìm Chrome/Edge cài trên máy
# (src/server/utils/chromePath.js); chỉ cần đặt khi trình duyệt nằm ở chỗ khác.
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# ---- Thông tin đơn vị hiển thị trên bản in / PDF ----
COMPANY_NAME=
COMPANY_ADDRESS=
COMPANY_PHONE=
# Logo PNG cho PDF phía server (mặc định public/logo.png)
# COMPANY_LOGO_PATH=./public/logo.png
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_COMPANY_PHONE=

# ---- Chế độ demo (portfolio) ----
# Bật đăng nhập một chạm vào các tài khoản demo ở trang /login (npm run demo:seed để tạo dữ liệu)
DEMO_MODE=false
# Tự làm mới dữ liệu demo theo lịch (chỉ xoá dữ liệu do tài khoản demo tạo)
DEMO_AUTO_RESET=false
DEMO_RESET_CRON=0 3 * * *

# Thời hạn duyệt mặc định (giờ) cho bước không cấu hình SLA - dùng ở trang Phân tích
FW_DEFAULT_SLA_HOURS=24

# ---- Nhắc hạn & leo thang SLA (src/server/models/fw/sla.js) ----
# FW_SLA_ALERTS=true
# FW_SLA_CRON=*/15 * * * *
# Nhắc "sắp đến hạn" khi đã dùng tỉ lệ này của thời hạn
# FW_SLA_REMIND_RATIO=0.75
# Quá hạn thêm bao nhiêu giờ thì báo lên phụ trách bộ phận/phòng ban (hoặc Quản trị viên)
# FW_SLA_ESCALATE_AFTER_HOURS=24
# Bỏ qua đề xuất đã chờ quá số ngày này
# FW_SLA_MAX_AGE_DAYS=30

# ---- Docker (docker compose --profile app up -d --build) ----
# Địa chỉ công khai của app khi deploy
# PUBLIC_APP_URL=https://fastwork.example.com
# APP_PUBLISH_PORT=3000
# DB_PUBLISH_PORT=3306
# Tự tạo dữ liệu demo lần khởi động đầu khi DEMO_MODE=true
# DEMO_SEED_ON_START=true
# Địa chỉ nội bộ cho job làm mới dữ liệu demo (khi APP_URL là tên miền công khai)
# DEMO_API_BASE=http://127.0.0.1:3000/api
